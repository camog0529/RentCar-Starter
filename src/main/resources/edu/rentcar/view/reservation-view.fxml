<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.rentcar.controller.ReservationController" spacing="14">
    <Label text="Rental reservation" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8;">
        <Label text="Reservation workflow" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
        <Label text="This screen is a starting point. The reservation workflow, request validation, availability, pricing, service packages and payment integration must be designed and implemented as part of the assignment." wrapText="true"/>
        <Label text="No reservation is created by the starter application." style="-fx-text-fill: #64748b;"/>
    </VBox>
</VBox>
